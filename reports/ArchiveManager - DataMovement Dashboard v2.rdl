    <DataSet Name="dsEstimateRFLOG2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pShowEstimates">
            <Value>=Parameters!pShowEstimates.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF @pShowEstimates = 0
BEGIN
    SELECT CAST(NULL AS nvarchar(4000)) AS ProcessCode
         , CAST(NULL AS nvarchar(4000)) AS SourceDb
         , CAST(NULL AS tinyint) AS Mode
         , CAST(NULL AS datetime) AS AsOfUtc
         , CAST(NULL AS datetime) AS EffectiveCutoffUtc
         , CAST(NULL AS bigint) AS TotalRows
         , CAST(NULL AS bigint) AS ValidRows
         , CAST(NULL AS bigint) AS NullRows
         , CAST(NULL AS bigint) AS EmptyRows
         , CAST(NULL AS bigint) AS InvalidRows
         , CAST(NULL AS bigint) AS CandidateRows
         , CAST(NULL AS datetime) AS MinCandidateUtc
         , CAST(NULL AS datetime) AS MaxCandidateUtc
         , CAST(NULL AS bigint) AS CurrentRowCount
         , CAST(NULL AS decimal(38,4)) AS CurrentUsedMB
         , CAST(NULL AS decimal(38,4)) AS AvgRowBytes
         , CAST(NULL AS decimal(38,4)) AS EstimatedReductionMB
         , CAST(NULL AS decimal(38,4)) AS EstimatedArchiveGrowthMB
         , CAST(NULL AS decimal(38,4)) AS CurrentUsedDbMB
         , CAST(NULL AS decimal(38,4)) AS EstimatedReductionPctOfDb
    WHERE 1 = 0;
    RETURN;
END;

IF OBJECT_ID('tempdb..#RFLOG2Estimate') IS NOT NULL DROP TABLE #RFLOG2Estimate;
CREATE TABLE #RFLOG2Estimate
(
    ProcessCode nvarchar(4000) NULL,
    SourceDb nvarchar(4000) NULL,
    Mode tinyint NULL,
    AsOfUtc datetime NULL,
    EffectiveCutoffUtc datetime NULL,
    TotalRows bigint NULL,
    ValidRows bigint NULL,
    NullRows bigint NULL,
    EmptyRows bigint NULL,
    InvalidRows bigint NULL,
    CandidateRows bigint NULL,
    MinCandidateUtc datetime NULL,
    MaxCandidateUtc datetime NULL,
    CurrentRowCount bigint NULL,
    CurrentUsedMB decimal(38,4) NULL,
    AvgRowBytes decimal(38,4) NULL,
    EstimatedReductionMB decimal(38,4) NULL,
    EstimatedArchiveGrowthMB decimal(38,4) NULL,
    CurrentUsedDbMB decimal(38,4) NULL,
    EstimatedReductionPctOfDb decimal(38,4) NULL
);

DECLARE @SourceDb sysname;

DECLARE rf_cursor CURSOR LOCAL FAST_FORWARD FOR
SELECT DISTINCT e.SourceDb
FROM arch.v_ProcessDatabaseEffective e
WHERE e.IsEnabled = 1
  AND e.ProcessCode = N'RF_LOG2'
  AND e.SourceDb IS NOT NULL
  AND DB_ID(e.SourceDb) IS NOT NULL
ORDER BY e.SourceDb;

OPEN rf_cursor;
FETCH NEXT FROM rf_cursor INTO @SourceDb;

WHILE @@FETCH_STATUS = 0
BEGIN
    BEGIN TRY
        INSERT #RFLOG2Estimate
        EXEC arch.usp_EstimateCurrentProcessImpact_RF_LOG2
            @SourceDb = @SourceDb;
    END TRY
    BEGIN CATCH
        INSERT #RFLOG2Estimate
        SELECT CAST(N'RF_LOG2 (odhad nedostupný)' AS nvarchar(4000)) AS ProcessCode
             , CAST(COALESCE(CONVERT(nvarchar(4000), @SourceDb), N'') + N' | SQL chyba: ' + ERROR_MESSAGE() AS nvarchar(4000)) AS SourceDb
             , CAST(NULL AS tinyint) AS Mode
             , CAST(NULL AS datetime) AS AsOfUtc
             , CAST(NULL AS datetime) AS EffectiveCutoffUtc
             , CAST(NULL AS bigint) AS TotalRows
             , CAST(NULL AS bigint) AS ValidRows
             , CAST(NULL AS bigint) AS NullRows
             , CAST(NULL AS bigint) AS EmptyRows
             , CAST(NULL AS bigint) AS InvalidRows
             , CAST(NULL AS bigint) AS CandidateRows
             , CAST(NULL AS datetime) AS MinCandidateUtc
             , CAST(NULL AS datetime) AS MaxCandidateUtc
             , CAST(NULL AS bigint) AS CurrentRowCount
             , CAST(NULL AS decimal(38,4)) AS CurrentUsedMB
             , CAST(NULL AS decimal(38,4)) AS AvgRowBytes
             , CAST(NULL AS decimal(38,4)) AS EstimatedReductionMB
             , CAST(NULL AS decimal(38,4)) AS EstimatedArchiveGrowthMB
             , CAST(NULL AS decimal(38,4)) AS CurrentUsedDbMB
             , CAST(NULL AS decimal(38,4)) AS EstimatedReductionPctOfDb;
    END CATCH;

    FETCH NEXT FROM rf_cursor INTO @SourceDb;
END;

CLOSE rf_cursor;
DEALLOCATE rf_cursor;

SELECT *
FROM #RFLOG2Estimate
ORDER BY SourceDb, ProcessCode;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Mode">
          <DataField>Mode</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
