    <DataSet Name="dsDocLookupSummary">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pDocLookup">
            <Value>=Parameters!pDocLookup.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Search nvarchar(256) = NULLIF(LTRIM(RTRIM(@pDocLookup)), N'');

;WITH M AS
(
    SELECT
        a.RunDocAuditId,
        a.ProcessCode,
        a.DocKeyLabel,
        a.DocKey,
        a.DocCreatedAt,
        a.DeletedAt,
        a.Archived,
        ri.Mode,
        ri.CutoffUtc,
        r.RunId,
        r.SourceDb,
        r.ArchiveDb
    FROM arch.RunDocAudit a
    INNER JOIN arch.RunItem ri
        ON ri.RunItemId = a.RunItemId
    INNER JOIN arch.Run r
        ON r.RunId = ri.RunId
    WHERE @Search IS NOT NULL
      AND a.DocKey = @Search
)
SELECT
    SearchValue = COALESCE(@Search, N''),
    FoundFlag = CASE WHEN EXISTS (SELECT 1 FROM M) THEN 1 ELSE 0 END,
    MatchCount = (SELECT COUNT(1) FROM M),
    ResultText =
        CASE
            WHEN @Search IS NULL THEN N'Zadejte identifikátor dokladu do parametru reportu.'
            WHEN EXISTS (SELECT 1 FROM M) THEN N'Doklad prošel arch procesem.'
            ELSE N'Doklad arch procesem neprošel.'
        END,
    ProcessCodes =
        COALESCE(
            STUFF(
                (
                    SELECT DISTINCT N', ' + m2.ProcessCode
                    FROM M m2
                    FOR XML PATH(''), TYPE
                ).value('.', 'nvarchar(max)'),
                1, 2, N''
            ),
            N''
        ),
    DocKeyLabel =
        COALESCE(
            (SELECT TOP (1) m.DocKeyLabel FROM M m ORDER BY m.DeletedAt DESC, m.RunDocAuditId DESC),
            N''
        ),
    FirstDocCreatedAtText =
        COALESCE(CONVERT(nvarchar(19), (SELECT MIN(m.DocCreatedAt) FROM M m), 120), N''),
    LastDeletedAtText =
        COALESCE(CONVERT(nvarchar(19), (SELECT MAX(m.DeletedAt) FROM M m), 120), N''),
    ArchivedText =
        CASE
            WHEN EXISTS (SELECT 1 FROM M WHERE Archived = 1) THEN N'ANO'
            WHEN EXISTS (SELECT 1 FROM M) THEN N'NE'
            ELSE N''
        END,
    LastCutoffUtcText =
        COALESCE(CONVERT(nvarchar(19), (SELECT MAX(m.CutoffUtc) FROM M m), 120), N''),
    LastRunId =
        COALESCE(CONVERT(nvarchar(20), (SELECT MAX(m.RunId) FROM M m)), N''),
    SourceDb =
        COALESCE(
            (SELECT TOP (1) m.SourceDb FROM M m ORDER BY m.DeletedAt DESC, m.RunDocAuditId DESC),
            N''
        ),
    ArchiveDb =
        COALESCE(
            (SELECT TOP (1) m.ArchiveDb FROM M m ORDER BY m.DeletedAt DESC, m.RunDocAuditId DESC),
            N''
        );</CommandText>
      </Query>
      <Fields>
        <Field Name="SearchValue">
          <DataField>SearchValue</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FoundFlag">
          <DataField>FoundFlag</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="MatchCount">
          <DataField>MatchCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ResultText">
          <DataField>ResultText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcessCodes">
          <DataField>ProcessCodes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DocKeyLabel">
          <DataField>DocKeyLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FirstDocCreatedAtText">
          <DataField>FirstDocCreatedAtText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastDeletedAtText">
          <DataField>LastDeletedAtText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchivedText">
          <DataField>ArchivedText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastCutoffUtcText">
          <DataField>LastCutoffUtcText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastRunId">
          <DataField>LastRunId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveDb">
          <DataField>ArchiveDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDocLookupDetails">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pDocLookup">
            <Value>=Parameters!pDocLookup.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>DECLARE @Search nvarchar(256) = NULLIF(LTRIM(RTRIM(@pDocLookup)), N'');

SELECT TOP (200)
    ProcessCode = a.ProcessCode + CHAR(13) + CHAR(10) + COALESCE(r.SourceDb, N''),
    r.SourceDb,
    a.DocKeyLabel,
    a.DocKey,
    DocCreatedAtText = COALESCE(CONVERT(nvarchar(19), a.DocCreatedAt, 120), N''),
    DeletedAtText = CONVERT(nvarchar(19), a.DeletedAt, 120),
    ArchivedText = CASE a.Archived WHEN 1 THEN N'ANO' ELSE N'NE' END,
    ModeText =
        CASE ri.Mode
            WHEN 0 THEN N'Delete only'
            WHEN 1 THEN N'Archive + delete'
            ELSE CONVERT(nvarchar(10), ri.Mode)
        END,
    CutoffRunText =
        COALESCE(CONVERT(nvarchar(19), ri.CutoffUtc, 120), N'')
        + N' | Run ' + CONVERT(nvarchar(20), r.RunId)
FROM arch.RunDocAudit a
INNER JOIN arch.RunItem ri
    ON ri.RunItemId = a.RunItemId
INNER JOIN arch.Run r
    ON r.RunId = ri.RunId
WHERE @Search IS NOT NULL
  AND a.DocKey = @Search
ORDER BY a.DeletedAt DESC, a.RunDocAuditId DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DocKeyLabel">
          <DataField>DocKeyLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DocKey">
          <DataField>DocKey</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DocCreatedAtText">
          <DataField>DocCreatedAtText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DeletedAtText">
          <DataField>DeletedAtText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchivedText">
          <DataField>ArchivedText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ModeText">
          <DataField>ModeText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CutoffRunText">
          <DataField>CutoffRunText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
