  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=REPLACE_WITH_YOUR_SQL_INSTANCE;Initial Catalog=kArchiveManagerAdmin</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>3a7d2f34-b7d0-4d9a-a6d2-1234567890ab</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsReportContext">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>;WITH DbScope AS
(
    SELECT DISTINCT
        SourceDb,
        ArchiveDb
    FROM arch.v_ProcessDatabaseEffective
    WHERE IsEnabled = 1
      AND SourceDb IS NOT NULL
      AND LTRIM(RTRIM(SourceDb)) &lt;&gt; N''
)
SELECT
    SourceDb = COALESCE(src.SourceDbs, N'nezjištěno'),
    ArchiveDb = COALESCE(arc.ArchiveDbs, N'nezjištěno'),
    ContextText =
        N'Zdrojové databáze: '
        + COALESCE(src.SourceDbs, N'nezjištěno')
        + N' | Archivní databáze: '
        + COALESCE(arc.ArchiveDbs, N'nezjištěno')
FROM
(
    SELECT SourceDbs =
        STUFF
        (
            (
                SELECT DISTINCT N', ' + SourceDb
                FROM DbScope
                ORDER BY N', ' + SourceDb
                FOR XML PATH(N''), TYPE
            ).value(N'.', N'nvarchar(max)'),
            1,
            2,
            N''
        )
) src
CROSS JOIN
(
    SELECT ArchiveDbs =
        STUFF
        (
            (
                SELECT DISTINCT N', ' + ArchiveDb
                FROM DbScope
                WHERE ArchiveDb IS NOT NULL
                ORDER BY N', ' + ArchiveDb
                FOR XML PATH(N''), TYPE
            ).value(N'.', N'nvarchar(max)'),
            1,
            2,
            N''
        )
) arc;</CommandText>
      </Query>
      <Fields>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveDb">
          <DataField>ArchiveDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ContextText">
          <DataField>ContextText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsProcessConfig">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
    p.ProcessCode,
    SourceDatabases = COALESCE(db.SourceDatabases, N''),
    IsEnabled =
        CASE p.IsEnabled
            WHEN 1 THEN N'ANO'
            WHEN 0 THEN N'NE'
            ELSE CAST(p.IsEnabled AS nvarchar(20))
        END,
    Mode =
        CASE p.Mode
            WHEN 0 THEN N'Delete only'
            WHEN 1 THEN N'Archive + delete'
            ELSE CAST(p.Mode AS nvarchar(30))
        END,
    RetentionDays         = CAST(p.RetentionDays AS nvarchar(30)),
    CutoffLagMinutes      = CAST(p.CutoffSafetyLagMinutes AS nvarchar(30)),
    BatchDocCount         = CAST(p.BatchDocCount AS nvarchar(30)),
    BatchRowCount         = CAST(p.BatchRowCount AS nvarchar(30)),
    MaxBatchesPerRun      = CAST(p.MaxBatchesPerRun AS nvarchar(30)),
    DelayMsBetweenBatches = CAST(p.DelayMsBetweenBatches AS nvarchar(30)),
    LockTimeoutMs         = CAST(p.LockTimeoutMs AS nvarchar(30))
FROM arch.Process p
OUTER APPLY
(
    SELECT SourceDatabases =
        STUFF
        (
            (
                SELECT N', ' + pd.SourceDb
                FROM arch.ProcessDatabase pd
                WHERE pd.ProcessId = p.ProcessId
                ORDER BY pd.RunOrder, pd.SourceDb
                FOR XML PATH(N''), TYPE
            ).value(N'.', N'nvarchar(max)'),
            1,
            2,
            N''
        )
) db
ORDER BY p.ProcessId;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceDatabases">
          <DataField>SourceDatabases</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IsEnabled">
          <DataField>IsEnabled</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Mode">
          <DataField>Mode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RetentionDays">
          <DataField>RetentionDays</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CutoffLagMinutes">
          <DataField>CutoffLagMinutes</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BatchDocCount">
          <DataField>BatchDocCount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BatchRowCount">
          <DataField>BatchRowCount</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaxBatchesPerRun">
          <DataField>MaxBatchesPerRun</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DelayMsBetweenBatches">
          <DataField>DelayMsBetweenBatches</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LockTimeoutMs">
          <DataField>LockTimeoutMs</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsTableCounts">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>IF OBJECT_ID('tempdb..#ObjectMap') IS NOT NULL DROP TABLE #ObjectMap;
IF OBJECT_ID('tempdb..#DateRanges') IS NOT NULL DROP TABLE #DateRanges;
IF OBJECT_ID('tempdb..#SourceMeta') IS NOT NULL DROP TABLE #SourceMeta;
IF OBJECT_ID('tempdb..#ArchiveMeta') IS NOT NULL DROP TABLE #ArchiveMeta;

CREATE TABLE #ObjectMap
(
    ProcessCode nvarchar(50) NOT NULL,
    SourceDb sysname NOT NULL,
    ArchiveDb sysname NOT NULL,
    SourceSchema sysname NOT NULL,
    SourceTable sysname NOT NULL,
    ArchiveSchema sysname NOT NULL,
    ArchiveTable sysname NOT NULL,
    DeleteOrder int NOT NULL
);

INSERT #ObjectMap(ProcessCode, SourceDb, ArchiveDb, SourceSchema, SourceTable, ArchiveSchema, ArchiveTable, DeleteOrder)
SELECT DISTINCT
    ProcessCode,
    SourceDb,
    ArchiveDb,
    SourceSchema,
    SourceTable,
    ArchiveSchema = CONVERT(sysname, REPLACE(
        CASE
            WHEN NULLIF(LTRIM(RTRIM(ArchiveSchema)), N'') IS NULL OR LTRIM(RTRIM(ArchiveSchema)) = N'dbo' THEN N'{SourceDb}'
            ELSE LTRIM(RTRIM(ArchiveSchema))
        END,
        N'{SourceDb}', SourceDb)),
    ArchiveTable = COALESCE(NULLIF(LTRIM(RTRIM(ArchiveTable)), N''), SourceTable),
    DeleteOrder
FROM arch.v_ObjectSpecDatabaseEffective
WHERE ProcessDatabaseIsEnabled = 1
  AND ObjectIsEnabled = 1
  AND SourceDb IS NOT NULL
  AND ArchiveDb IS NOT NULL
  AND DB_ID(SourceDb) IS NOT NULL
  AND DB_ID(ArchiveDb) IS NOT NULL;

IF NOT EXISTS (SELECT 1 FROM #ObjectMap)
BEGIN
    SELECT TOP (0)
        CAST(NULL AS sysname)        AS SourceDb,
        CAST(NULL AS sysname)        AS ArchiveDb,
        CAST(NULL AS nvarchar(50))   AS ProcessCode,
        CAST(NULL AS sysname)        AS SourceSchema,
        CAST(NULL AS sysname)        AS SourceTable,
        CAST(NULL AS sysname)        AS ArchiveSchema,
        CAST(NULL AS sysname)        AS ArchiveTable,
        CAST(NULL AS int)            AS DeleteOrder,
        CAST(NULL AS nvarchar(500))  AS ObjectContextKey,
        CAST(NULL AS nvarchar(300))  AS SourceObjectLabel,
        CAST(NULL AS nvarchar(400))  AS ArchiveObjectLabel,
        CAST(NULL AS nvarchar(600))  AS ObjectGraphLabel,
        CAST(NULL AS int)            AS SourceArchiveRank,
        CAST(NULL AS int)            AS DifferenceRank,
        CAST(NULL AS bigint)         AS SourceRows,
        CAST(NULL AS bigint)         AS ArchivedRows,
        CAST(NULL AS bigint)         AS DifferenceCount,
        CAST(NULL AS datetime2(0))   AS MinBusinessDate,
        CAST(NULL AS datetime2(0))   AS MaxBusinessDate,
        CAST(NULL AS nvarchar(64))   AS BusinessDateLabel,
        CAST(NULL AS nvarchar(128))  AS BusinessDateExprLabel,
        CAST(NULL AS nvarchar(64))   AS BusinessDateDisplay,
        CAST(NULL AS nvarchar(300))  AS BusinessDateGraphLabel;
    RETURN;
END;

CREATE TABLE #DateRanges
(
    SourceDb sysname NOT NULL,
    SourceTable sysname NOT NULL,
    MinBusinessDate datetime2(0) NULL,
    MaxBusinessDate datetime2(0) NULL,
    BusinessDateLabel nvarchar(64) NULL,
    BusinessDateExprLabel nvarchar(128) NULL
);

CREATE TABLE #SourceMeta
(
    SourceDb sysname NOT NULL,
    SourceSchema sysname NOT NULL,
    SourceTable sysname NOT NULL,
    SourceRows bigint NOT NULL
);

CREATE TABLE #ArchiveMeta
(
    SourceDb sysname NOT NULL,
    ArchiveDb sysname NOT NULL,
    ArchiveSchema sysname NOT NULL,
    ArchiveTable sysname NOT NULL,
    ArchivedRows bigint NOT NULL
);

DECLARE
    @SourceDb sysname,
    @ArchiveDb sysname,
    @BackObject nvarchar(300),
    @ShipObject nvarchar(300),
    @RfObject nvarchar(300),
    @BackExpr nvarchar(400),
    @ShipExpr nvarchar(400),
    @RfExpr nvarchar(400),
    @sql nvarchar(max);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
    SELECT SourceDb, ArchiveDb
    FROM #ObjectMap
    GROUP BY SourceDb, ArchiveDb
    ORDER BY SourceDb, ArchiveDb;

OPEN db_cursor;
FETCH NEXT FROM db_cursor INTO @SourceDb, @ArchiveDb;

WHILE @@FETCH_STATUS = 0
BEGIN
    SET @BackObject = @SourceDb + N'.dbo.BACKRH';
    SET @ShipObject = @SourceDb + N'.dbo.SHIPHIST';
    SET @RfObject = @SourceDb + N'.dbo.RF_LOG2';
    SET @sql = N'';

    SET @BackExpr =
    (
        SELECT CASE
            WHEN COL_LENGTH(@BackObject, 'RECVD_ON') IS NOT NULL AND COL_LENGTH(@BackObject, 'DATE_CREAT') IS NOT NULL
                THEN N'COALESCE(RECVD_ON, DATE_CREAT)'
            WHEN COL_LENGTH(@BackObject, 'RECVD_ON') IS NOT NULL AND COL_LENGTH(@BackObject, 'DATECREATE') IS NOT NULL
                THEN N'COALESCE(RECVD_ON, DATECREATE)'
            WHEN COL_LENGTH(@BackObject, 'RECVD_ON') IS NOT NULL
                THEN N'RECVD_ON'
            WHEN COL_LENGTH(@BackObject, 'DATE_CREAT') IS NOT NULL
                THEN N'DATE_CREAT'
            WHEN COL_LENGTH(@BackObject, 'DATECREATE') IS NOT NULL
                THEN N'DATECREATE'
            ELSE NULL
        END
    );

    SET @ShipExpr =
    (
        SELECT CASE
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_CREAT') IS NOT NULL
                THEN N'COALESCE(DATE_UPLD, DATE_SHIP, DATE_CREAT)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATECREATE') IS NOT NULL
                THEN N'COALESCE(DATE_UPLD, DATE_SHIP, DATECREATE)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_CREAT') IS NOT NULL
                THEN N'COALESCE(DATE_UPLD, DATE_CREAT)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATECREATE') IS NOT NULL
                THEN N'COALESCE(DATE_UPLD, DATECREATE)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_CREAT') IS NOT NULL
                THEN N'COALESCE(DATE_SHIP, DATE_CREAT)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATECREATE') IS NOT NULL
                THEN N'COALESCE(DATE_SHIP, DATECREATE)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL AND COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL
                THEN N'COALESCE(DATE_UPLD, DATE_SHIP)'
            WHEN COL_LENGTH(@ShipObject, 'DATE_UPLD') IS NOT NULL
                THEN N'DATE_UPLD'
            WHEN COL_LENGTH(@ShipObject, 'DATE_SHIP') IS NOT NULL
                THEN N'DATE_SHIP'
            WHEN COL_LENGTH(@ShipObject, 'DATE_CREAT') IS NOT NULL
                THEN N'DATE_CREAT'
            WHEN COL_LENGTH(@ShipObject, 'DATECREATE') IS NOT NULL
                THEN N'DATECREATE'
            ELSE NULL
        END
    );

    SET @RfExpr =
    (
        SELECT CASE
            WHEN COL_LENGTH(@RfObject, 'DATE_TIME') IS NOT NULL
                THEN N'TRY_CONVERT(datetime2(0), NULLIF(LTRIM(RTRIM(CONVERT(nvarchar(100), DATE_TIME))), N''''))'
            ELSE NULL
        END
    );

    IF @BackExpr IS NOT NULL
    BEGIN
        SET @sql += N'
;WITH R AS
(
    SELECT
        MinBusinessDate = MIN(CONVERT(datetime2(0), ' + @BackExpr + N')),
        MaxBusinessDate = MAX(CONVERT(datetime2(0), ' + @BackExpr + N'))
    FROM ' + QUOTENAME(@SourceDb) + N'.dbo.BACKRH WITH (NOLOCK)
    WHERE ' + @BackExpr + N' IS NOT NULL
)
INSERT INTO #DateRanges (SourceDb, SourceTable, MinBusinessDate, MaxBusinessDate, BusinessDateLabel, BusinessDateExprLabel)
SELECT
    @pSourceDb,
    v.SourceTable,
    R.MinBusinessDate,
    R.MaxBusinessDate,
    CASE
        WHEN R.MinBusinessDate IS NULL THEN NULL
        WHEN R.MinBusinessDate = R.MaxBusinessDate THEN CONVERT(varchar(10), R.MinBusinessDate, 104)
        ELSE CONVERT(varchar(10), R.MinBusinessDate, 104) + N'' - '' + CONVERT(varchar(10), R.MaxBusinessDate, 104)
    END,
    N''BACKRH''
FROM (VALUES (N''BACKRH''), (N''BACKRD'')) v(SourceTable)
CROSS JOIN R;';
    END;

    IF @ShipExpr IS NOT NULL
    BEGIN
        SET @sql += N'
;WITH R AS
(
    SELECT
        MinBusinessDate = MIN(CONVERT(datetime2(0), ' + @ShipExpr + N')),
        MaxBusinessDate = MAX(CONVERT(datetime2(0), ' + @ShipExpr + N'))
    FROM ' + QUOTENAME(@SourceDb) + N'.dbo.SHIPHIST WITH (NOLOCK)
    WHERE ' + @ShipExpr + N' IS NOT NULL
)
INSERT INTO #DateRanges (SourceDb, SourceTable, MinBusinessDate, MaxBusinessDate, BusinessDateLabel, BusinessDateExprLabel)
SELECT
    @pSourceDb,
    v.SourceTable,
    R.MinBusinessDate,
    R.MaxBusinessDate,
    CASE
        WHEN R.MinBusinessDate IS NULL THEN NULL
        WHEN R.MinBusinessDate = R.MaxBusinessDate THEN CONVERT(varchar(10), R.MinBusinessDate, 104)
        ELSE CONVERT(varchar(10), R.MinBusinessDate, 104) + N'' - '' + CONVERT(varchar(10), R.MaxBusinessDate, 104)
    END,
    N''SHIPHIST''
FROM (VALUES (N''SHIPHIST''), (N''SHIPLINE''), (N''SHIPLINE2''), (N''SHIPDETL''), (N''SHIPDETL2''), (N''SHIPMSTR'')) v(SourceTable)
CROSS JOIN R;';
    END;

    IF @RfExpr IS NOT NULL
    BEGIN
        SET @sql += N'
;WITH R AS
(
    SELECT
        MinBusinessDate = MIN(' + @RfExpr + N'),
        MaxBusinessDate = MAX(' + @RfExpr + N')
    FROM ' + QUOTENAME(@SourceDb) + N'.dbo.RF_LOG2 WITH (NOLOCK)
    WHERE ' + @RfExpr + N' IS NOT NULL
)
INSERT INTO #DateRanges (SourceDb, SourceTable, MinBusinessDate, MaxBusinessDate, BusinessDateLabel, BusinessDateExprLabel)
SELECT
    @pSourceDb,
    N''RF_LOG2'',
    R.MinBusinessDate,
    R.MaxBusinessDate,
    CASE
        WHEN R.MinBusinessDate IS NULL THEN NULL
        WHEN R.MinBusinessDate = R.MaxBusinessDate THEN CONVERT(varchar(10), R.MinBusinessDate, 104)
        ELSE CONVERT(varchar(10), R.MinBusinessDate, 104) + N'' - '' + CONVERT(varchar(10), R.MaxBusinessDate, 104)
    END,
    N''DATE_TIME''
FROM R;';
    END;

    SET @sql += N'
INSERT INTO #SourceMeta (SourceDb, SourceSchema, SourceTable, SourceRows)
SELECT
    @pSourceDb,
    s.name,
    t.name,
    SUM(CASE WHEN p.index_id IN (0,1) THEN p.rows ELSE 0 END)
FROM ' + QUOTENAME(@SourceDb) + N'.sys.tables t
INNER JOIN ' + QUOTENAME(@SourceDb) + N'.sys.schemas s
    ON s.schema_id = t.schema_id
INNER JOIN ' + QUOTENAME(@SourceDb) + N'.sys.partitions p
    ON p.object_id = t.object_id
GROUP BY s.name, t.name;

INSERT INTO #ArchiveMeta (SourceDb, ArchiveDb, ArchiveSchema, ArchiveTable, ArchivedRows)
SELECT
    @pSourceDb,
    @pArchiveDb,
    s.name,
    t.name,
    SUM(CASE WHEN p.index_id IN (0,1) THEN p.rows ELSE 0 END)
FROM ' + QUOTENAME(@ArchiveDb) + N'.sys.tables t
INNER JOIN ' + QUOTENAME(@ArchiveDb) + N'.sys.schemas s
    ON s.schema_id = t.schema_id
INNER JOIN ' + QUOTENAME(@ArchiveDb) + N'.sys.partitions p
    ON p.object_id = t.object_id
GROUP BY s.name, t.name;';

    EXEC sys.sp_executesql
        @sql,
        N'@pSourceDb sysname, @pArchiveDb sysname',
        @pSourceDb = @SourceDb,
        @pArchiveDb = @ArchiveDb;

    FETCH NEXT FROM db_cursor INTO @SourceDb, @ArchiveDb;
END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

SELECT
    m.SourceDb,
    m.ArchiveDb,
    m.ProcessCode,
    m.SourceSchema,
    m.SourceTable,
    m.ArchiveSchema,
    m.ArchiveTable,
    m.DeleteOrder,
    ObjectContextKey =
        m.ProcessCode + N'|' + m.SourceDb + N'|' + m.SourceSchema + N'|' + m.SourceTable + N'|' +
        m.ArchiveDb + N'|' + m.ArchiveSchema + N'|' + m.ArchiveTable + N'|' +
        CONVERT(nvarchar(20), m.DeleteOrder) + N'|' + COALESCE(dr.BusinessDateLabel, N'n/a'),
    SourceObjectLabel =
        m.ProcessCode + N' #' + CONVERT(nvarchar(20), m.DeleteOrder) +
        N' / ' + m.SourceDb + N'.' + m.SourceTable +
        N' -&gt; ' + m.ArchiveSchema + N'.' + m.ArchiveTable,
    ArchiveObjectLabel = m.ArchiveDb + N'.' + m.ArchiveSchema + N'.' + m.ArchiveTable,
    ObjectGraphLabel =
        m.ProcessCode + N' #' + CONVERT(nvarchar(20), m.DeleteOrder) + CHAR(13) + CHAR(10) +
        m.SourceDb + N'.' + m.SourceTable + CHAR(13) + CHAR(10) +
        N'Archiv: ' + m.ArchiveSchema + N'.' + m.ArchiveTable + CHAR(13) + CHAR(10) +
        COALESCE(dr.BusinessDateLabel, N'n/a'),
    SourceArchiveRank = ROW_NUMBER() OVER
    (
        ORDER BY
            CASE
                WHEN ABS(COALESCE(sm.SourceRows, 0)) &gt;= ABS(COALESCE(am.ArchivedRows, 0))
                    THEN ABS(COALESCE(sm.SourceRows, 0))
                ELSE ABS(COALESCE(am.ArchivedRows, 0))
            END DESC,
            m.SourceDb,
            m.ProcessCode,
            m.DeleteOrder,
            m.SourceTable
    ),
    DifferenceRank = ROW_NUMBER() OVER
    (
        ORDER BY
            ABS(COALESCE(sm.SourceRows, 0) - COALESCE(am.ArchivedRows, 0)) DESC,
            m.SourceDb,
            m.ProcessCode,
            m.DeleteOrder,
            m.SourceTable
    ),
    SourceRows = COALESCE(sm.SourceRows, 0),
    ArchivedRows = COALESCE(am.ArchivedRows, 0),
    DifferenceCount = COALESCE(sm.SourceRows, 0) - COALESCE(am.ArchivedRows, 0),
    dr.MinBusinessDate,
    dr.MaxBusinessDate,
    dr.BusinessDateLabel,
    dr.BusinessDateExprLabel,
    BusinessDateDisplay = COALESCE(dr.BusinessDateLabel, N'n/a'),
    BusinessDateGraphLabel =
        m.ProcessCode + CHAR(13) + CHAR(10) +
        m.SourceDb + N'.' + m.SourceTable + CHAR(13) + CHAR(10) +
        COALESCE(dr.BusinessDateLabel, N'n/a')
FROM #ObjectMap m
LEFT JOIN #SourceMeta sm
    ON sm.SourceDb = m.SourceDb
   AND sm.SourceSchema = m.SourceSchema
   AND sm.SourceTable = m.SourceTable
LEFT JOIN #ArchiveMeta am
    ON am.SourceDb = m.SourceDb
   AND am.ArchiveDb = m.ArchiveDb
   AND am.ArchiveSchema = m.ArchiveSchema
   AND am.ArchiveTable = m.ArchiveTable
LEFT JOIN #DateRanges dr
    ON dr.SourceDb = m.SourceDb
   AND dr.SourceTable = m.SourceTable
ORDER BY
    m.SourceDb,
    m.ProcessCode,
    m.DeleteOrder,
    m.SourceTable;</CommandText>
      </Query>
      <Fields>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveDb">
          <DataField>ArchiveDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceSchema">
          <DataField>SourceSchema</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceTable">
          <DataField>SourceTable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveSchema">
          <DataField>ArchiveSchema</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveTable">
          <DataField>ArchiveTable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DeleteOrder">
          <DataField>DeleteOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ObjectContextKey">
          <DataField>ObjectContextKey</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceObjectLabel">
          <DataField>SourceObjectLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArchiveObjectLabel">
          <DataField>ArchiveObjectLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ObjectGraphLabel">
          <DataField>ObjectGraphLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceArchiveRank">
          <DataField>SourceArchiveRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DifferenceRank">
          <DataField>DifferenceRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SourceRows">
          <DataField>SourceRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ArchivedRows">
          <DataField>ArchivedRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="DifferenceCount">
          <DataField>DifferenceCount</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="MinBusinessDate">
          <DataField>MinBusinessDate</DataField>
        </Field>
        <Field Name="MaxBusinessDate">
          <DataField>MaxBusinessDate</DataField>
        </Field>
        <Field Name="BusinessDateLabel">
          <DataField>BusinessDateLabel</DataField>
        </Field>
        <Field Name="BusinessDateExprLabel">
          <DataField>BusinessDateExprLabel</DataField>
        </Field>
        <Field Name="BusinessDateDisplay">
          <DataField>BusinessDateDisplay</DataField>
        </Field>
        <Field Name="BusinessDateGraphLabel">
          <DataField>BusinessDateGraphLabel</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsProcessSummary">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>DECLARE @SourceDb sysname =
(
    SELECT TOP (1) r.SourceDb
    FROM arch.Run r
    WHERE r.SourceDb IS NOT NULL
      AND LTRIM(RTRIM(r.SourceDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

DECLARE @ArchiveDb sysname =
(
    SELECT TOP (1) r.ArchiveDb
    FROM arch.Run r
    WHERE r.ArchiveDb IS NOT NULL
      AND LTRIM(RTRIM(r.ArchiveDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

IF @SourceDb IS NULL OR DB_ID(@SourceDb) IS NULL OR @ArchiveDb IS NULL OR DB_ID(@ArchiveDb) IS NULL
BEGIN
    SELECT TOP (0)
        CAST(NULL AS nvarchar(50)) AS ProcessCode,
        CAST(NULL AS bigint)       AS SourceRows,
        CAST(NULL AS bigint)       AS ArchivedRows,
        CAST(NULL AS bigint)       AS DifferenceCount;
    RETURN;
END;

IF OBJECT_ID('tempdb..#SourceMeta') IS NOT NULL DROP TABLE #SourceMeta;
IF OBJECT_ID('tempdb..#ArchiveMeta') IS NOT NULL DROP TABLE #ArchiveMeta;

CREATE TABLE #SourceMeta
(
    SourceSchema sysname NOT NULL,
    SourceTable sysname NOT NULL,
    SourceRows bigint NOT NULL
);

CREATE TABLE #ArchiveMeta
(
    ArchiveSchema sysname NOT NULL,
    ArchiveTable sysname NOT NULL,
    ArchivedRows bigint NOT NULL
);

DECLARE @sql nvarchar(max) = N'
INSERT INTO #SourceMeta (SourceSchema, SourceTable, SourceRows)
SELECT
    s.name,
    t.name,
    SUM(CASE WHEN p.index_id IN (0,1) THEN p.rows ELSE 0 END)
FROM ' + QUOTENAME(@SourceDb) + N'.sys.tables t
INNER JOIN ' + QUOTENAME(@SourceDb) + N'.sys.schemas s
    ON s.schema_id = t.schema_id
INNER JOIN ' + QUOTENAME(@SourceDb) + N'.sys.partitions p
    ON p.object_id = t.object_id
GROUP BY s.name, t.name;

INSERT INTO #ArchiveMeta (ArchiveSchema, ArchiveTable, ArchivedRows)
SELECT
    s.name,
    t.name,
    SUM(CASE WHEN p.index_id IN (0,1) THEN p.rows ELSE 0 END)
FROM ' + QUOTENAME(@ArchiveDb) + N'.sys.tables t
INNER JOIN ' + QUOTENAME(@ArchiveDb) + N'.sys.schemas s
    ON s.schema_id = t.schema_id
INNER JOIN ' + QUOTENAME(@ArchiveDb) + N'.sys.partitions p
    ON p.object_id = t.object_id
GROUP BY s.name, t.name;';

EXEC sys.sp_executesql @sql;

;WITH Map AS
(
    SELECT *
    FROM (VALUES
        (N'RECEIVING', N'dbo', N'BACKRH',    N'dbo', N'BACKRH'),
        (N'RECEIVING', N'dbo', N'BACKRD',    N'dbo', N'BACKRD'),
        (N'SHIPPING',  N'dbo', N'SHIPHIST',  N'dbo', N'SHIPHIST'),
        (N'SHIPPING',  N'dbo', N'SHIPLINE',  N'dbo', N'SHIPLINE'),
        (N'SHIPPING',  N'dbo', N'SHIPLINE2', N'dbo', N'SHIPLINE2'),
        (N'SHIPPING',  N'dbo', N'SHIPDETL',  N'dbo', N'SHIPDETL'),
        (N'SHIPPING',  N'dbo', N'SHIPDETL2', N'dbo', N'SHIPDETL2'),
        (N'SHIPPING',  N'dbo', N'SHIPMSTR',  N'dbo', N'SHIPMSTR'),
        (N'RF_LOG2',   N'dbo', N'RF_LOG2',   N'dbo', N'RF_LOG2')
    ) v(ProcessCode, SourceSchema, SourceTable, ArchiveSchema, ArchiveTable)
)
SELECT
    m.ProcessCode,
    SourceRows = SUM(COALESCE(sm.SourceRows, 0)),
    ArchivedRows = SUM(COALESCE(am.ArchivedRows, 0)),
    DifferenceCount = SUM(COALESCE(sm.SourceRows, 0) - COALESCE(am.ArchivedRows, 0))
FROM Map m
LEFT JOIN #SourceMeta sm
    ON sm.SourceSchema = m.SourceSchema
   AND sm.SourceTable = m.SourceTable
LEFT JOIN #ArchiveMeta am
    ON am.ArchiveSchema = m.ArchiveSchema
   AND am.ArchiveTable = m.ArchiveTable
GROUP BY
    m.ProcessCode
ORDER BY
    CASE m.ProcessCode WHEN N'RECEIVING' THEN 1 WHEN N'SHIPPING' THEN 2 WHEN N'RF_LOG2' THEN 3 ELSE 99 END;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceRows">
          <DataField>SourceRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ArchivedRows">
          <DataField>ArchivedRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="DifferenceCount">
          <DataField>DifferenceCount</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDailyArchivedHistory">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>DECLARE @SourceDb sysname =
(
    SELECT TOP (1) r.SourceDb
    FROM arch.Run r
    WHERE r.SourceDb IS NOT NULL
      AND LTRIM(RTRIM(r.SourceDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

DECLARE @ArchiveDb sysname =
(
    SELECT TOP (1) r.ArchiveDb
    FROM arch.Run r
    WHERE r.ArchiveDb IS NOT NULL
      AND LTRIM(RTRIM(r.ArchiveDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

SELECT
    p.ProcessCode,
    rio.SourceTable,
    MoveDate = CONVERT(date, COALESCE(ri.EndedAt, r.EndedAt, ri.StartedAt, r.StartedAt)),
    ArchivedRows =
        SUM(CASE
                WHEN ri.Mode = 0 THEN ISNULL(rio.RowsDeleted, 0)
                ELSE ISNULL(rio.RowsArchived, 0)
            END)
FROM arch.Run r
INNER JOIN arch.RunItem ri
    ON ri.RunId = r.RunId
INNER JOIN arch.Process p
    ON p.ProcessId = ri.ProcessId
INNER JOIN arch.RunItemObject rio
    ON rio.RunItemId = ri.RunItemId
WHERE r.Status = N'OK'
  AND ri.Status = N'OK'
  AND (@SourceDb IS NULL OR r.SourceDb = @SourceDb)
  AND (@ArchiveDb IS NULL OR r.ArchiveDb = @ArchiveDb)
  AND rio.SourceTable IN
  (
      N'BACKRH', N'BACKRD',
      N'SHIPHIST', N'SHIPLINE', N'SHIPLINE2',
      N'SHIPDETL', N'SHIPDETL2', N'SHIPMSTR',
      N'RF_LOG2'
  )
GROUP BY
    p.ProcessCode,
    rio.SourceTable,
    CONVERT(date, COALESCE(ri.EndedAt, r.EndedAt, ri.StartedAt, r.StartedAt))
HAVING
    SUM(CASE
            WHEN ri.Mode = 0 THEN ISNULL(rio.RowsDeleted, 0)
            ELSE ISNULL(rio.RowsArchived, 0)
        END) &gt; 0
ORDER BY
    MoveDate,
    CASE p.ProcessCode WHEN N'RECEIVING' THEN 1 WHEN N'SHIPPING' THEN 2 WHEN N'RF_LOG2' THEN 3 ELSE 99 END,
    rio.SourceTable;</CommandText>
      </Query>
      <Fields>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceTable">
          <DataField>SourceTable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MoveDate">
          <DataField>MoveDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ArchivedRows">
          <DataField>ArchivedRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsProcessedByRunDayAndTable">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>;WITH X AS
(
    SELECT
        RunDate = CONVERT(date, COALESCE(ri.EndedAt, r.EndedAt, ri.StartedAt, r.StartedAt)),
        SourceDb = r.SourceDb,
        ProcessCode = COALESCE(p.ProcessCode,
            CASE ri.ProcessId
                WHEN 1 THEN N'RECEIVING'
                WHEN 2 THEN N'SHIPPING'
                ELSE N'PROCESS ' + CONVERT(nvarchar(10), ri.ProcessId)
            END),
        rio.SourceTable,
        CutoffUtc = MAX(CONVERT(datetime2(0), ri.CutoffUtc)),
        ProcessedRows =
            SUM(CASE
                    WHEN ri.Mode = 0 THEN ISNULL(rio.RowsDeleted, 0)
                    ELSE ISNULL(rio.RowsArchived, 0)
                END)
    FROM arch.Run r
    INNER JOIN arch.RunItem ri
        ON ri.RunId = r.RunId
    INNER JOIN arch.RunItemObject rio
        ON rio.RunItemId = ri.RunItemId
    LEFT JOIN arch.Process p
        ON p.ProcessId = ri.ProcessId
    WHERE r.Status = N'OK'
      AND ri.Status = N'OK'
      AND r.SourceDb IS NOT NULL
    GROUP BY
        CONVERT(date, COALESCE(ri.EndedAt, r.EndedAt, ri.StartedAt, r.StartedAt)),
        r.SourceDb,
        COALESCE(p.ProcessCode,
            CASE ri.ProcessId
                WHEN 1 THEN N'RECEIVING'
                WHEN 2 THEN N'SHIPPING'
                ELSE N'PROCESS ' + CONVERT(nvarchar(10), ri.ProcessId)
            END),
        rio.SourceTable
),
Y AS
(
    SELECT
        X.*,
        ProcessDailyRows = SUM(ProcessedRows) OVER (PARTITION BY RunDate, SourceDb, ProcessCode)
    FROM X
),
Z AS
(
    SELECT
        Y.*,
        ProcessDailyRank = DENSE_RANK() OVER
        (
            ORDER BY ProcessDailyRows DESC, RunDate DESC, SourceDb, ProcessCode
        ),
        TableDailyRank = ROW_NUMBER() OVER
        (
            ORDER BY ProcessedRows DESC, RunDate DESC, SourceDb, ProcessCode, SourceTable
        ),
        CutoffTableRank = ROW_NUMBER() OVER
        (
            ORDER BY ProcessedRows DESC, CutoffUtc DESC, SourceDb, ProcessCode, SourceTable
        )
    FROM Y
)
SELECT
    RunDate,
    SourceDb,
    ProcessCode,
    SourceTable,
    CutoffUtc,
    ProcessedRows,
    ProcessDailyKey =
        CONVERT(nvarchar(8), RunDate, 112) + N'|' + SourceDb + N'|' + ProcessCode,
    ProcessDailyLabel =
        ProcessCode + CHAR(13) + CHAR(10) +
        SourceDb + CHAR(13) + CHAR(10) +
        CONVERT(nvarchar(10), RunDate, 104),
    ProcessDailyRank,
    TableDailyKey =
        CONVERT(nvarchar(8), RunDate, 112) + N'|' + SourceDb + N'|' + ProcessCode + N'|' + SourceTable,
    TableDailyLabel =
        ProcessCode + CHAR(13) + CHAR(10) +
        SourceDb + N'.' + SourceTable + CHAR(13) + CHAR(10) +
        CONVERT(nvarchar(10), RunDate, 104),
    TableDailyRank,
    CutoffTableKey =
        COALESCE(CONVERT(nvarchar(19), CutoffUtc, 120), N'') + N'|' + SourceDb + N'|' + ProcessCode + N'|' + SourceTable,
    CutoffTableLabel =
        ProcessCode + CHAR(13) + CHAR(10) +
        SourceDb + N'.' + SourceTable + CHAR(13) + CHAR(10) +
        COALESCE(CONVERT(nvarchar(16), CutoffUtc, 120), N'n/a'),
    CutoffTableRank
FROM Z
WHERE ProcessedRows &gt; 0
ORDER BY
    RunDate,
    SourceDb,
    CASE ProcessCode WHEN N'RECEIVING' THEN 1 WHEN N'SHIPPING' THEN 2 WHEN N'RF_LOG2' THEN 3 ELSE 99 END,
    SourceTable;</CommandText>
      </Query>
      <Fields>
        <Field Name="RunDate">
          <DataField>RunDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcessCode">
          <DataField>ProcessCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SourceTable">
          <DataField>SourceTable</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CutoffUtc">
          <DataField>CutoffUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ProcessedRows">
          <DataField>ProcessedRows</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ProcessDailyKey">
          <DataField>ProcessDailyKey</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcessDailyLabel">
          <DataField>ProcessDailyLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProcessDailyRank">
          <DataField>ProcessDailyRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TableDailyKey">
          <DataField>TableDailyKey</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TableDailyLabel">
          <DataField>TableDailyLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TableDailyRank">
          <DataField>TableDailyRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CutoffTableKey">
          <DataField>CutoffTableKey</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CutoffTableLabel">
          <DataField>CutoffTableLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CutoffTableRank">
          <DataField>CutoffTableRank</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDeleteBacklogSummary">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>DECLARE @SourceDb sysname =
(
    SELECT TOP (1) r.SourceDb
    FROM arch.Run r
    WHERE r.SourceDb IS NOT NULL
      AND LTRIM(RTRIM(r.SourceDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

DECLARE @ArchiveDb sysname =
(
    SELECT TOP (1) r.ArchiveDb
    FROM arch.Run r
    WHERE r.ArchiveDb IS NOT NULL
      AND LTRIM(RTRIM(r.ArchiveDb)) &lt;&gt; N''
    ORDER BY COALESCE(r.EndedAt, r.StartedAt) DESC, r.RunId DESC
);

IF @SourceDb IS NULL OR DB_ID(@SourceDb) IS NULL
BEGIN
    SELECT TOP (0)
        CAST(NULL AS int)          AS RetentionDays,
        CAST(NULL AS datetime2(0)) AS ConfigCutoffUtc,
        CAST(NULL AS datetime2(0)) AS ActualCutoffUtc,
        CAST(NULL AS datetime) AS EffectiveCutoffUtc,
        CAST(NULL AS date)         AS Retence,
        CAST(NULL AS bigint)       AS Pocet,
        CAST(NULL AS datetime)     AS Minimum,
        CAST(NULL AS datetime)     AS Maximum;
    RETURN;
END;

IF OBJECT_ID('tempdb..#BacklogSummary') IS NOT NULL DROP TABLE #BacklogSummary;
CREATE TABLE #BacklogSummary
(
    RetentionDays int NULL,
    ConfigCutoffUtc datetime2(0) NULL,
    ActualCutoffUtc datetime2(0) NULL,
    EffectiveCutoffUtc datetime2(0) NULL,
    Retence date NULL,
    Pocet bigint NULL,
    Minimum datetime NULL,
    Maximum datetime NULL
);

DECLARE @sql nvarchar(max) = N'
;WITH Base AS
(
    SELECT 1 AS X
),
ShippingConfig AS
(
    SELECT TOP (1)
        RetentionDays   = p.RetentionDays,
        ConfigCutoffUtc = CONVERT(datetime2(0), DATEADD(DAY, -ISNULL(p.RetentionDays, 0), GETDATE()))
    FROM arch.Process p
    WHERE p.ProcessCode = N''SHIPPING''
    ORDER BY p.ProcessId
),
LastShippingRun AS
(
    SELECT TOP (1)
        ActualCutoffUtc = CONVERT(datetime2(0), ri.CutoffUtc)
    FROM arch.Run r
    INNER JOIN arch.RunItem ri
        ON ri.RunId = r.RunId
    INNER JOIN arch.Process p
        ON p.ProcessId = ri.ProcessId
    WHERE r.Status = N''OK''
      AND (@SourceDb IS NULL OR r.SourceDb = @SourceDb)
      AND (@ArchiveDb IS NULL OR r.ArchiveDb = @ArchiveDb)
      AND p.ProcessCode = N''SHIPPING''
      AND ri.CutoffUtc IS NOT NULL
    ORDER BY r.StartedAt DESC, ri.RunItemId DESC
),
Effective AS
(
    SELECT
        RetentionDays      = sc.RetentionDays,
        ConfigCutoffUtc    = sc.ConfigCutoffUtc,
        ActualCutoffUtc    = lsr.ActualCutoffUtc,
        EffectiveCutoffUtc = COALESCE(lsr.ActualCutoffUtc, sc.ConfigCutoffUtc)
    FROM Base b
    LEFT JOIN ShippingConfig sc
        ON 1 = 1
    LEFT JOIN LastShippingRun lsr
        ON 1 = 1
)
SELECT
    RetentionDays      = e.RetentionDays,
    ConfigCutoffUtc    = e.ConfigCutoffUtc,
    ActualCutoffUtc    = e.ActualCutoffUtc,
    EffectiveCutoffUtc = e.EffectiveCutoffUtc,
    Retence            = CONVERT(date, e.EffectiveCutoffUtc),
    Pocet              = COUNT_BIG(h.DATE_UPLD),
    Minimum            = MIN(h.DATE_UPLD),
    Maximum            = MAX(h.DATE_UPLD)
FROM Effective e
LEFT JOIN ' + QUOTENAME(@SourceDb) + N'.dbo.SHIPHIST h WITH (NOLOCK)
    ON e.EffectiveCutoffUtc IS NOT NULL
   AND h.DATE_UPLD &lt; e.EffectiveCutoffUtc
GROUP BY
    e.RetentionDays,
    e.ConfigCutoffUtc,
    e.ActualCutoffUtc,
    e.EffectiveCutoffUtc;';

INSERT INTO #BacklogSummary
EXEC sys.sp_executesql
    @sql,
    N'@SourceDb sysname, @ArchiveDb sysname',
    @SourceDb = @SourceDb,
    @ArchiveDb = @ArchiveDb;

SELECT
    RetentionDays,
    ConfigCutoffUtc,
    ActualCutoffUtc,
    EffectiveCutoffUtc,
    Retence,
    Pocet,
    Minimum,
    Maximum
FROM #BacklogSummary;</CommandText>
      </Query>
      <Fields>
        <Field Name="RetentionDays">
          <DataField>RetentionDays</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ConfigCutoffUtc">
          <DataField>ConfigCutoffUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ActualCutoffUtc">
          <DataField>ActualCutoffUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EffectiveCutoffUtc">
          <DataField>EffectiveCutoffUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Pocet">
          <DataField>Pocet</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Minimum">
          <DataField>Minimum</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Maximum">
          <DataField>Maximum</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Retence">
          <DataField>Retence</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsDeleteBacklogByDay">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>IF OBJECT_ID('tempdb..#DbScope') IS NOT NULL DROP TABLE #DbScope;
IF OBJECT_ID('tempdb..#BacklogByDay') IS NOT NULL DROP TABLE #BacklogByDay;

CREATE TABLE #DbScope
(
    SourceDb sysname NOT NULL,
    ArchiveDb sysname NOT NULL,
    RetentionDays int NULL,
    RunOrder int NOT NULL
);

INSERT #DbScope(SourceDb, ArchiveDb, RetentionDays, RunOrder)
SELECT
    SourceDb,
    ArchiveDb,
    RetentionDays,
    RunOrder
FROM arch.v_ProcessDatabaseEffective
WHERE IsEnabled = 1
  AND ProcessCode = N'SHIPPING'
  AND SourceDb IS NOT NULL
  AND ArchiveDb IS NOT NULL
  AND DB_ID(SourceDb) IS NOT NULL;

IF NOT EXISTS (SELECT 1 FROM #DbScope)
BEGIN
    SELECT TOP (0)
        CAST(NULL AS sysname)      AS SourceDb,
        CAST(NULL AS date)         AS DeleteDay,
        CAST(NULL AS bigint)       AS Pocet,
        CAST(NULL AS date)         AS Retence,
        CAST(NULL AS int)          AS RetentionDays,
        CAST(NULL AS datetime2(0)) AS ConfigCutoffUtc,
        CAST(NULL AS datetime2(0)) AS ActualCutoffUtc,
        CAST(NULL AS datetime)     AS EffectiveCutoffUtc,
        CAST(NULL AS nvarchar(200)) AS BacklogKey,
        CAST(NULL AS nvarchar(300)) AS BacklogLabel,
        CAST(NULL AS int)          AS BacklogRank;
    RETURN;
END;

CREATE TABLE #BacklogByDay
(
    SourceDb sysname NULL,
    DeleteDay date NULL,
    Pocet bigint NULL,
    Retence date NULL,
    RetentionDays int NULL,
    ConfigCutoffUtc datetime2(0) NULL,
    ActualCutoffUtc datetime2(0) NULL,
    EffectiveCutoffUtc datetime2(0) NULL
);

DECLARE
    @SourceDb sysname,
    @ArchiveDb sysname,
    @RetentionDays int,
    @ConfigCutoffUtc datetime2(0),
    @ActualCutoffUtc datetime2(0),
    @EffectiveCutoffUtc datetime2(0),
    @sql nvarchar(max);

DECLARE db_cursor CURSOR LOCAL FAST_FORWARD FOR
    SELECT SourceDb, ArchiveDb, RetentionDays
    FROM #DbScope
    ORDER BY RunOrder, SourceDb, ArchiveDb;

OPEN db_cursor;
FETCH NEXT FROM db_cursor INTO @SourceDb, @ArchiveDb, @RetentionDays;

WHILE @@FETCH_STATUS = 0
BEGIN
    SET @ConfigCutoffUtc = CONVERT(datetime2(0), DATEADD(DAY, -ISNULL(@RetentionDays, 0), GETDATE()));

    SELECT TOP (1)
        @ActualCutoffUtc = CONVERT(datetime2(0), ri.CutoffUtc)
    FROM arch.Run r
    INNER JOIN arch.RunItem ri
        ON ri.RunId = r.RunId
    INNER JOIN arch.Process p
        ON p.ProcessId = ri.ProcessId
    WHERE r.Status = N'OK'
      AND ri.Status = N'OK'
      AND r.SourceDb = @SourceDb
      AND r.ArchiveDb = @ArchiveDb
      AND p.ProcessCode = N'SHIPPING'
      AND ri.CutoffUtc IS NOT NULL
    ORDER BY COALESCE(ri.EndedAt, r.EndedAt, ri.StartedAt, r.StartedAt) DESC, ri.RunItemId DESC;

    SET @EffectiveCutoffUtc = COALESCE(@ActualCutoffUtc, @ConfigCutoffUtc);

    IF COL_LENGTH(@SourceDb + N'.dbo.SHIPHIST', 'DATE_UPLD') IS NOT NULL
    BEGIN
        SET @sql = N'
INSERT INTO #BacklogByDay(SourceDb, DeleteDay, Pocet, Retence, RetentionDays, ConfigCutoffUtc, ActualCutoffUtc, EffectiveCutoffUtc)
SELECT
    @pSourceDb,
    DeleteDay = CONVERT(date, h.DATE_UPLD),
    Pocet = COUNT_BIG(1),
    Retence = CONVERT(date, @pEffectiveCutoffUtc),
    @pRetentionDays,
    @pConfigCutoffUtc,
    @pActualCutoffUtc,
    @pEffectiveCutoffUtc
FROM ' + QUOTENAME(@SourceDb) + N'.dbo.SHIPHIST h WITH (NOLOCK)
WHERE @pEffectiveCutoffUtc IS NOT NULL
  AND h.DATE_UPLD &lt; @pEffectiveCutoffUtc
GROUP BY CONVERT(date, h.DATE_UPLD);';

        EXEC sys.sp_executesql
            @sql,
            N'@pSourceDb sysname,
              @pRetentionDays int,
              @pConfigCutoffUtc datetime2(0),
              @pActualCutoffUtc datetime2(0),
              @pEffectiveCutoffUtc datetime2(0)',
            @pSourceDb = @SourceDb,
            @pRetentionDays = @RetentionDays,
            @pConfigCutoffUtc = @ConfigCutoffUtc,
            @pActualCutoffUtc = @ActualCutoffUtc,
            @pEffectiveCutoffUtc = @EffectiveCutoffUtc;
    END;

    FETCH NEXT FROM db_cursor INTO @SourceDb, @ArchiveDb, @RetentionDays;
END;

CLOSE db_cursor;
DEALLOCATE db_cursor;

SELECT
    SourceDb,
    DeleteDay,
    Pocet,
    Retence,
    RetentionDays,
    ConfigCutoffUtc,
    ActualCutoffUtc,
    EffectiveCutoffUtc,
    BacklogKey = SourceDb + N'|' + CONVERT(nvarchar(8), DeleteDay, 112),
    BacklogLabel =
        SourceDb + N'.SHIPHIST' + CHAR(13) + CHAR(10) +
        CONVERT(nvarchar(10), DeleteDay, 104) + CHAR(13) + CHAR(10) +
        N'Cutoff: ' + COALESCE(CONVERT(nvarchar(16), EffectiveCutoffUtc, 120), N'n/a'),
    BacklogRank = ROW_NUMBER() OVER (ORDER BY Pocet DESC, SourceDb, DeleteDay)
FROM #BacklogByDay
ORDER BY SourceDb, DeleteDay;</CommandText>
      </Query>
      <Fields>
        <Field Name="SourceDb">
          <DataField>SourceDb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DeleteDay">
          <DataField>DeleteDay</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
