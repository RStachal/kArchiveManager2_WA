 &amp; IIF(First(Fields!FoundFlag.Value, "dsDocLookupSummary") = 1,
     vbCrLf &amp; "Typ identifikátoru: " &amp; First(Fields!DocKeyLabel.Value, "dsDocLookupSummary")
     &amp; "; Procesy: " &amp; First(Fields!ProcessCodes.Value, "dsDocLookupSummary")
     &amp; "; Počet zásahů v logu: " &amp; CStr(First(Fields!MatchCount.Value, "dsDocLookupSummary"))
     &amp; "; Doklad vytvořen: " &amp; First(Fields!FirstDocCreatedAtText.Value, "dsDocLookupSummary")
     &amp; "; Naposledy smazáno: " &amp; First(Fields!LastDeletedAtText.Value, "dsDocLookupSummary")
     &amp; "; Archivováno: " &amp; First(Fields!ArchivedText.Value, "dsDocLookupSummary")
     &amp; "; Poslední CutoffUtc: " &amp; First(Fields!LastCutoffUtcText.Value, "dsDocLookupSummary")
     &amp; "; SourceDb: " &amp; First(Fields!SourceDb.Value, "dsDocLookupSummary")
     &amp; "; ArchiveDb: " &amp; First(Fields!ArchiveDb.Value, "dsDocLookupSummary"),
     ""
 )</Value>
